# =============================================================
# TRAEFIK - Configuration du reverse proxy
# =============================================================

# Adresse courriel pour Let's Encrypt (notifications d'expiration de certificat)
MY_EMAIL=ton.email@exemple.com

# Domaine DuckDNS principal (ex: tp3-2387907.duckdns.org)
# Traefik générera un certificat wildcard pour *.MY_DOMAIN
MY_DOMAIN=ton-sous-domaine.duckdns.org

# Token DuckDNS (trouvable sur https://www.duckdns.org après connexion)
# Utilisé par Traefik pour le DNS Challenge Let's Encrypt
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================
# JELLYFIN - Serveur multimédia
# =============================================================

# Chemin absolu vers le dossier de médias sur l'instance EC2
# Ex: /home/ubuntu/media  ou  /mnt/media
JELLYFIN_MEDIA_PATH=/home/ubuntu/media

# =============================================================
# BLOGVERSE - Base de données MySQL
# =============================================================

# Mot de passe root MySQL (fort, jamais partagé)
MYSQL_ROOT_PASSWORD=rootpassword_a_changer

# Nom de la base de données de l'application BlogVerse
MYSQL_DATABASE=blogverse

# Utilisateur MySQL applicatif (pas root)
MYSQL_USER=blogverse_user

# Mot de passe de l'utilisateur applicatif
MYSQL_PASSWORD=blogverse_password_a_changer

# =============================================================
# BLOGVERSE - Backend Node/Express
# =============================================================

# Clé secrète pour la signature des tokens JWT
# Générer avec : openssl rand -base64 64
JWT_SECRET=ton_secret_jwt_tres_long_et_aleatoire

# Durée de validité des tokens JWT (ex: 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d
